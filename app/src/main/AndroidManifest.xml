<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_verity"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_verity_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verity">
        <activity
            android:name="com.verity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Verity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Lets Share hand a generated PDF to another app (WhatsApp, Gmail, ...) as a content://
             URI — a raw file:// path into app-private storage is blocked by the OS since Android
             7 (StrictMode FileUriExposedException). Scoped via file_paths.xml to exactly the
             "documents" subfolder PDFs are written to (see DefaultInvoicePdfRenderer) — nothing
             else in app-private storage is exposed. Not exported: only this app can trigger a
             grant, via FLAG_GRANT_READ_URI_PERMISSION on the share Intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>